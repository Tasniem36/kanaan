# Copy to .env on the server and fill in. Used by docker-compose.prod.yml.

# Your domain (no https://, no trailing slash). Caddy gets HTTPS for it automatically.
DOMAIN=dukkan-kanaan.com

# Database
DB_NAME=dukkan
DB_PASSWORD=use-a-long-random-password-here

# Auth — MUST be a long random string in production
JWT_SECRET=paste-a-64-char-random-string-here

# First manager account, created automatically on first boot
SEED_MANAGER_EMAIL=you@example.com
SEED_MANAGER_PASSWORD=a-strong-password

# Optional: new-order alerts. Any configured channel below receives them.
# Telegram (recommended, reliable): create a bot via @BotFather for the token,
# then message the bot and get your numeric chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp via CallMeBot (free, best-effort — see DEPLOY.md "WhatsApp alerts").
# Your number in international form, e.g. 9715XXXXXXXX (no + or spaces).
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Sign-up verification codes. A channel is only REQUIRED if it's configured here,
# so leaving one blank simply skips that check (never locks customers out).
# Email code via Gmail app password (Google account → Security → App passwords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Phone (SMS) code via Twilio (Console → Account SID / Auth Token, and a sender number):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Online payments via Ziina. Get an API key from your Ziina Business dashboard.
# Set ZIINA_TEST=true while testing (no real charges), false for live.
ZIINA_API_KEY=
ZIINA_TEST=true
