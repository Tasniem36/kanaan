# Copy to .env on the server and fill in. Used by docker-compose.prod.yml.

# Your domain (no https://, no trailing slash). Caddy gets HTTPS for it automatically.
DOMAIN=dukkan-kanaan.com

# Database
DB_NAME=dukkan
DB_PASSWORD=use-a-long-random-password-here

# Auth — MUST be a long random string in production
JWT_SECRET=paste-a-64-char-random-string-here

# First manager account, created automatically on first boot
SEED_MANAGER_EMAIL=you@example.com
SEED_MANAGER_PASSWORD=a-strong-password

# Optional: new-order alerts. Any configured channel below receives them.
# Telegram (recommended, reliable): create a bot via @BotFather for the token,
# then message the bot and get your numeric chat id from @userinfobot.
# TELEGRAM_CHAT_ID takes more than one recipient, comma-separated — a second phone,
# or a channel id (negative, e.g. -1001234567890). See DEPLOY.md "Telegram order alerts".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp via CallMeBot (free, best-effort — see DEPLOY.md "WhatsApp alerts").
# Your number in international form, e.g. 9715XXXXXXXX (no + or spaces).
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Sign-up verification codes. A channel is only REQUIRED if it's configured here,
# so leaving one blank simply skips that check (never locks customers out).
# Email code via Gmail app password (Google account → Security → App passwords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Phone (SMS) code via Twilio (Console → Account SID / Auth Token, and a sender number):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Web Push device notifications (VAPID). Generate a keypair once with:
#   python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives import serialization as s;k=ec.generate_private_key(ec.SECP256R1());b=lambda x:base64.urlsafe_b64encode(x).rstrip(b'=').decode();print('VAPID_PUBLIC_KEY='+b(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)));print('VAPID_PRIVATE_KEY='+b(k.private_numbers().private_value.to_bytes(32,'big')))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dukkan-kanaan.com

# Online payments via Ziina. Get an API key from your Ziina Business dashboard.
# Set ZIINA_TEST=true while testing (no real charges), false for live.
ZIINA_API_KEY=
ZIINA_TEST=true

# WhatsApp updates to the CUSTOMER — Meta WhatsApp Business Cloud API (billed per
# message). This is the only channel that reaches a guest: no account, so no in-app
# notification and no push, and they may have given no e-mail. Setup — including the
# two message templates Meta has to approve — is in DEPLOY.md.
# Leave WA_CLOUD_TOKEN empty and nothing is sent; the shop takes orders as before.
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
# Only if you named the approved templates something other than these:
# WA_TEMPLATE_PLACED=order_placed
# WA_TEMPLATE_STATUS=order_status
# WA_TEMPLATE_LANG=ar
# By default only customers with no other channel are messaged, because every
# template send is billed. true = message account holders as well.
# WA_NOTIFY_ALL=false

# --- everything below is optional; each falls back to its own default -------------
# The name e-mails come from, and where replies go.
# SMTP_FROM_NAME=دكّان كنعان
# SMTP_REPLY_TO=
# How long an unresolved Ziina payment may hold its stock before the sweep reads it
# as abandoned. Minimum 10, whatever is set here — a mistyped 1 would start releasing
# orders out from under payments that are still going through.
# PAYMENT_STALE_MINUTES=30
# How long customer activity is kept (minimum 7). The dashboard's "most opened
# products" and "where visitors come from" panels can only look back this far.
# AUDIT_RETENTION_DAYS=90
