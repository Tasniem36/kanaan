# Copy to server/.env and fill in.

# --- Database (Cloud SQL for PostgreSQL) ---
# Local dev via Cloud SQL Auth Proxy (recommended): run the proxy, then:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=dukkan
# DB_SSL=true   # only if connecting directly over public IP without the proxy

# On Cloud Run instead, leave DB_HOST unset and set:
# INSTANCE_CONNECTION_NAME=your-project:region:instance

# --- Auth ---
JWT_SECRET=generate-a-long-random-string

# --- Server ---
PORT=8080
# Comma-separated list of allowed frontend origins (dev + prod):
CORS_ORIGIN=http://localhost:5173

# --- WhatsApp updates to the customer (optional) ---
# Meta WhatsApp Business Cloud API. The only channel that reaches a guest who
# checked out with no e-mail address. See DEPLOY.md for the templates to submit.
# Unset, nothing is sent and nothing breaks.
# WA_CLOUD_TOKEN=your-permanent-access-token
# WA_CLOUD_PHONE_ID=your-phone-number-id
# WA_TEMPLATE_PLACED=order_placed
# WA_TEMPLATE_STATUS=order_status
# WA_TEMPLATE_LANG=ar
# WA_NOTIFY_ALL=false   # true also messages customers who have an account
