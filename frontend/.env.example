# Copy to .env.local (gitignored) to change where dev requests go.

# Where the Vite dev server (and `vite preview`) proxy /api and /media.
# Default when unset: http://localhost:8080 — a local API server.
# Set this to skip running one and read the live site instead (real data):
# VITE_API_PROXY=https://dukkan-kanaan.com

# Bypass the proxy entirely and let the browser call an absolute API base.
# Needs CORS on that server; the proxy above is the easier route.
# VITE_API_URL=https://dukkan-kanaan.com/api
